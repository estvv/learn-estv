# Cookies de session marqués Secure (mettre 0 uniquement en dev HTTP).
COOKIE_SECURE=1

# Mistral (lot 5) : laisser vide pour désactiver toutes les fonctions IA.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# Lecture d'images (partitions, numéros) ; vide : le meilleur que permet l'abonnement.
MISTRAL_VISION_MODEL=

# Gemini (lecture d'images, essayé avant Mistral) ; clé : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Vide : le meilleur modèle gratuit disponible.
GEMINI_MODEL=
